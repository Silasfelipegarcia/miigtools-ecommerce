</main>
<footer>
  <div class="footer-miig-trust">
    <div class="container">
      <div class="row row-cols-2 row-cols-md-4 text-center g-0">
        <div class="col"><i class="fa-solid fa-screwdriver-wrench"></i> Ferramentas profissionais</div>
        <div class="col"><i class="fa-solid fa-truck-fast"></i> Envio para todo o Brasil</div>
        <div class="col"><i class="fa-solid fa-shield-halved"></i> Compra segura</div>
        <div class="col"><i class="fa-solid fa-headset"></i> Suporte ao cliente</div>
      </div>
    </div>
  </div>
  <div class="footer-miig-pay">
    <div class="container">
      <p class="footer-miig-pay-title">{{ text_pay_title }}</p>
      <ul class="footer-miig-pay-list list-unstyled mb-0">
        <li><i class="fa-brands fa-pix" aria-hidden="true"></i> {{ text_pay_pix }}</li>
        <li><i class="fa-solid fa-wallet" aria-hidden="true"></i> {{ text_pay_mp }}</li>
        <li><i class="fa-regular fa-credit-card" aria-hidden="true"></i> {{ text_pay_card }}</li>
        <li><i class="fa-solid fa-building-columns" aria-hidden="true"></i> {{ text_pay_transfer }}</li>
        <li><i class="fa-solid fa-truck-fast" aria-hidden="true"></i> {{ text_ship_br }}</li>
      </ul>
    </div>
  </div>
  <div class="container">
    <div class="row">
      {% if informations or blog %}
        <div class="col-sm-3">
          <h5>{{ text_information }}</h5>
          <ul class="list-unstyled">
            {% if blog %}
              <li><a href="{{ blog }}">{{ text_blog }}</a></li>
            {% endif %}
            {% for information in informations %}
              <li><a href="{{ information.href }}">{{ information.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
      <div class="col-sm-3">
        <h5>{{ text_service }}</h5>
        <ul class="list-unstyled">
          <li><a href="{{ contact }}">{{ text_contact }}</a></li>
          {% if whatsapp_url %}
            <li><a href="{{ whatsapp_url }}" target="_blank" rel="noopener noreferrer">{{ whatsapp_label }}</a></li>
          {% endif %}
          <li><a href="{{ return }}">{{ text_return }}</a></li>
          {% if gdpr %}
            <li><a href="{{ gdpr }}">{{ text_gdpr }}</a></li>
          {% endif %}
          <li><a href="{{ sitemap }}">{{ text_sitemap }}</a></li>
        </ul>
      </div>
      <div class="col-sm-3">
        <h5>{{ text_extra }}</h5>
        <ul class="list-unstyled">
          <li><a href="{{ manufacturer }}">{{ text_manufacturer }}</a></li>
          {% if affiliate %}
            <li><a href="{{ affiliate }}">{{ text_affiliate }}</a></li>
          {% endif %}
          <li><a href="{{ special }}">{{ text_special }}</a></li>
          {% if faq_href %}
            <li><a href="{{ faq_href }}">{{ text_faq }}</a></li>
          {% endif %}
        </ul>
      </div>
      {% if applications %}
        <div class="col-sm-3">
          <h5>{{ text_applications }}</h5>
          <ul class="list-unstyled">
            {% for app in applications %}
              <li><a href="{{ app.href }}">{{ app.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
      <div class="col-sm-3">
        <h5>{{ text_account }}</h5>
        <ul class="list-unstyled">
          <li><a href="{{ account }}">{{ text_account }}</a></li>
          <li><a href="{{ order }}">{{ text_order }}</a></li>
          <li><a href="{{ wishlist }}">{{ text_wishlist }}</a></li>
          <li><a href="{{ newsletter }}">{{ text_newsletter }}</a></li>
        </ul>
      </div>
    </div>
    <hr>
    <p class="footer-miig-copy">{{ powered }}</p>
  </div>
</footer>
{% if whatsapp_url %}
  <a href="{{ whatsapp_url }}" class="miig-whatsapp" target="_blank" rel="noopener noreferrer" aria-label="{{ whatsapp_label }}" title="{{ whatsapp_label }}">
    <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
    <span class="miig-whatsapp-label">{{ whatsapp_label }}</span>
  </a>
{% endif %}
</div>
{{ cookie }}
<script src="{{ bootstrap }}" type="text/javascript"></script>
{% for script in scripts %}
  <script src="{{ script.href }}" type="text/javascript"></script>
{% endfor %}
</body></html>
