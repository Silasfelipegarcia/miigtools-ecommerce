{{ header }}
<div id="account-order" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    <div id="content" class="col">{{ content_top }}
      <h1>{{ heading_title }}</h1>
      <p class="form-text mb-3">Consulte status, total e abra o pedido para recomprar itens.</p>
      {% if orders %}
        <div class="table-responsive">
          <table class="table table-bordered table-hover align-middle">
            <thead>
              <tr>
                <th>{{ column_order_id }}</th>
                <th>{{ column_date_added }}</th>
                <th>{{ column_status }}</th>
                <th class="text-end">{{ column_product_total }}</th>
                <th class="text-end">{{ column_total }}</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {% for order in orders %}
                <tr>
                  <td><strong>#{{ order.order_id }}</strong></td>
                  <td>{{ order.date_added }}</td>
                  <td><span class="badge text-bg-secondary">{{ order.status }}</span></td>
                  <td class="text-end">{{ order.product_total }}</td>
                  <td class="text-end">{{ order.total }}</td>
                  <td class="text-end text-nowrap">
                    <a href="{{ order.view }}" class="btn btn-primary btn-sm"><i class="fa-solid fa-eye"></i> {{ button_view }}</a>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        <div class="row mb-3">
          <div class="col-sm-6 text-start">{{ pagination }}</div>
          <div class="col-sm-6 text-end">{{ results }}</div>
        </div>
      {% else %}
        <p>{{ text_no_results }}</p>
      {% endif %}
      <div class="text-end"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}
